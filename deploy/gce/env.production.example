# Production env for GCE / Docker Compose
# Copy to backend/.env on the VM: cp deploy/gce/env.production.example .env

APP_NAME=Reef
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Compose postgres service (override with Cloud SQL URL if needed)
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+psycopg://reef:change-me-strong-password@postgres:5432/reef

CORAL_MODE=cli
CORAL_BINARY=coral
CORAL_CONFIG_DIR=/data/coral
CORAL_SQL_TIMEOUT=90
CORAL_SETUP_ON_START=true
CORAL_SETUP_SMOKE=false
MAX_INVESTIGATION_ITERATIONS=5

CONFIDENCE_THRESHOLD=0.6
SEVERITY_THRESHOLD=0.7

# Frontend URL(s) — comma-separated for CORS (add your Vercel domain)
CORS_ORIGINS=https://your-reef-app.vercel.app,http://localhost:5173

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_ACCOUNT_TYPE=user

SENTRY_ORG=
SENTRY_TOKEN=

SLACK_TOKEN=
SLACK_INCIDENT_CHANNEL=incidents
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

VERCEL_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
