APP_NAME=Reef
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./reef.db

# Coral integration
# CORAL_MODE=cli   — runs `coral sql` via subprocess (requires `brew install withcoral/tap/coral`)
# CORAL_MODE=mock  — returns canned demo rows; safe for local dev without Coral installed
CORAL_MODE=mock
CORAL_BINARY=coral
CORAL_SQL_TIMEOUT=30
MAX_INVESTIGATION_ITERATIONS=5

# Decision thresholds
CONFIDENCE_THRESHOLD=0.6
SEVERITY_THRESHOLD=0.7

# External services — used only on the write/remediation path, not for investigation reads
GITHUB_TOKEN=
VERCEL_TOKEN=
SENTRY_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# LLM planner (Phase 4B — leave empty to use template planner)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
