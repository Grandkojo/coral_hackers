APP_NAME=Reef
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./reef.db

# =============================================================================
# Reef ↔ Coral runtime
# =============================================================================
# mock — canned demo rows (no Coral install required)
# cli  — runs `coral sql` subprocess (requires sources configured below)
CORAL_MODE=mock
CORAL_BINARY=coral
# Use full path if coral is not on PATH, e.g. /home/you/.local/bin/coral
CORAL_SQL_TIMEOUT=90
MAX_INVESTIGATION_ITERATIONS=5
# Cap Coral SQL that hits github.* tables per investigation (each may fan out to REST calls)
MAX_GITHUB_QUERIES_PER_INVESTIGATION=2

CONFIDENCE_THRESHOLD=0.6
SEVERITY_THRESHOLD=0.7

# =============================================================================
# Shared integration credentials
# =============================================================================
# Fill these once. Reef reads them at runtime; Coral reads matching names when
# you run ./scripts/setup_coral_sources.sh (non-interactive `coral source add`).
#
# Variable            Used by                         Purpose
# ------------------  ------------------------------  ---------------------------------
# GITHUB_TOKEN        Coral github + Reef remediation GitHub API access
# SENTRY_ORG          Coral sentry only               Org slug from Sentry URL
# SENTRY_TOKEN        Coral sentry + Reef remediation Sentry API access
# SLACK_TOKEN         Coral slack only                Read channels/messages (xoxb-)
# SLACK_BOT_TOKEN     Reef remediation only           Post messages / approval gate
# SLACK_SIGNING_SECRET Reef Slack triggers only       Verify slash-command requests
# VERCEL_TOKEN        Coral vercel + Reef remediation Deployments read / rollback
# VERCEL_TEAM_ID      Coral vercel only               Team-scoped projects (optional)

# --- GitHub ---
# PAT or `gh auth token`. Scopes: repo (or fine-grained PR/contents/metadata read)
GITHUB_TOKEN=
# Required for Coral github.pulls / github.collaborators filters
GITHUB_OWNER=
GITHUB_REPO=
# user — personal account (uses github.collaborators for ownership)
# org   — GitHub organization (uses github.teams)
GITHUB_ACCOUNT_TYPE=user
# Optional GitHub Enterprise API base (Coral github source only)
# GITHUB_API_BASE=https://api.github.com

# --- Sentry ---
# From URL: https://sentry.io/organizations/<SENTRY_ORG>/
SENTRY_ORG=
# Auth token: org:read, project:read, event:read
SENTRY_TOKEN=

# --- Slack ---
# Bot token for Coral SQL reads (#incidents history). Coral key name is SLACK_TOKEN.
SLACK_TOKEN=
# Channel name without # — used by planner iteration 2
SLACK_INCIDENT_CHANNEL=incidents
# Bot token for Reef to post reports/approvals. Often the same xoxb- as SLACK_TOKEN.
SLACK_BOT_TOKEN=
# From Slack app → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=

# Sentry internal integration webhook (async investigate + Slack post)
# Reef org UUID from dashboard URL /api/v1/organizations — overrides slug matching
WEBHOOK_ORGANIZATION_ID=
# Vercel frontend origin for links in Slack messages (no trailing slash)
FRONTEND_BASE_URL=

# --- Vercel (Reef remediation only today; Coral needs a community source spec) ---
VERCEL_TOKEN=
# VERCEL_TEAM_ID=

# =============================================================================
# One-time Coral source setup
# =============================================================================
# 1. cp .env.example .env and fill values above
# 2. export $(grep -v '^#' .env | xargs)   # or use direnv / your secret manager
# 3. ./scripts/setup_coral_sources.sh
# 4. Set CORAL_MODE=cli and restart uvicorn
#
# Coral stores configured sources locally after setup; re-run the script when
# rotating tokens or onboarding a new machine.

# LLM planner + judge (free tier — leave keys empty for template/rules fallback)
# Gemini: https://aistudio.google.com/apikey  (no credit card)
# Groq:   https://console.groq.com/keys
PLANNER_LLM_PROVIDER=gemini
JUDGE_LLM_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
PLANNER_MODEL=gemini-2.5-flash
JUDGE_MODEL=llama-3.3-70b-versatile

# --- Legacy paid providers (optional, not needed for hackathon demo) ---
# PLANNER_LLM_PROVIDER=anthropic
# JUDGE_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# PLANNER_MODEL=claude-sonnet-4-20250514
# JUDGE_MODEL=claude-3-5-haiku-20241022
# PLANNER_LLM_PROVIDER=openai
# JUDGE_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# Docker / GCE production (see deploy/gce/README.md)
# =============================================================================
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql+psycopg://reef:change-me@postgres:5432/reef
# CORAL_CONFIG_DIR=/data/coral
# CORAL_SETUP_ON_START=true
# CORAL_SETUP_SMOKE=false
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# =============================================================================
# Organization sessions (multi-tenant credentials in DB)
# =============================================================================
# JWT_SECRET=generate-a-long-random-string
# CREDENTIALS_ENCRYPTION_KEY=optional-separate-key-for-fernet
# AUTH_REQUIRED=true
# Local dev (writable): CORAL_ORGS_BASE_DIR=./data/coral/orgs
# GCE/Docker:         CORAL_ORGS_BASE_DIR=/data/coral/orgs
